  "words": {"title": "", "hook": "", "place_strings": [], "verb": "", "stat_nouns": [], "lead": "", "chips": [], "goal": "", "tips": [], "playing_word": "", "hover_hint": "", "own_word": "", "result_lines": [], "friend_lines": [], "quick_chat": [], "pause_line": ""},
